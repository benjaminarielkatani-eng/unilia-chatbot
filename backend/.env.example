# ─────────────────────────────────────────────────────────────
# UNILIA AI Helpdesk — Backend Environment Configuration
# ─────────────────────────────────────────────────────────────
# HOW TO USE:
#   1. Copy this file and rename it to ".env"
#   2. Fill in the values below
#   3. NEVER commit your .env file to GitHub — it contains secrets!
# ─────────────────────────────────────────────────────────────

# Application settings
APP_NAME=UNILIA AI Helpdesk
DEBUG=True

# ── Database ──────────────────────────────────────────────────
# SQLite (default — no installation needed, great for development)
DATABASE_URL=sqlite:///./unilia.db

# PostgreSQL (for production — uncomment and fill in your details)
# DATABASE_URL=postgresql://username:password@localhost:5432/unilia_db

# ── AI Engine (Macmillan's RAG pipeline) ─────────────────────
# Leave blank to use the built-in document search engine.
# When Macmillan deploys his engine, set this to his real URL.
# Example: AI_ENGINE_URL=http://192.168.1.10:8001
AI_ENGINE_URL=http://localhost:8001

# ── Security / JWT ────────────────────────────────────────────
# SECRET_KEY: a long random string used to sign login tokens.
# To generate one, run:
#   python -c "import secrets; print(secrets.token_hex(32))"
# IMPORTANT: Use the same value on all servers — changing it logs everyone out.
SECRET_KEY=change-this-to-a-long-random-secret-key

# JWT algorithm — do not change this
JWT_ALGORITHM=HS256

# How many minutes before the admin must log in again (default: 8 hours)
JWT_EXPIRE_MINUTES=480
