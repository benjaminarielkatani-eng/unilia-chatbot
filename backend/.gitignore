# Virtual environment - teammates rebuild this from requirements.txt
venv/

# Secret settings - NEVER upload passwords to GitHub
.env

# Python auto-generated files - not needed on GitHub
__pycache__/
*.pyc
*.pyo

# Test cache - created automatically when we run tests
.pytest_cache/

# Database files (if we ever test with a local SQLite file)
*.db

# Editor settings (personal preference files, not project files)
.vscode/
.idea/

# Uploaded documents - stored on the server only, never in Git
uploads/*
!uploads/.gitkeep
